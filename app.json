{
  "expo": {
    "name": "SpaceEase",
    "slug": "spaceease",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spaceease",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.spyfamily.spaceease",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spyfamily.spaceease",
      "adaptiveIcon": {
        "backgroundColor": "#20494A",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#20494A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "SpaceEase usa la cámara para tomar una foto de tu lugar de trabajo. Las caras se pixelan en el teléfono y la foto no se guarda.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SpaceEase escucha 10 segundos para notar voces o ruido de fondo. El sonido se analiza en el teléfono y se borra; nunca se envía."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8a260d13-9f19-4285-bfb0-0d42e197dec7"
      }
    },
    "owner": "quiqueexpo-2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a260d13-9f19-4285-bfb0-0d42e197dec7"
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    }
  }
}
